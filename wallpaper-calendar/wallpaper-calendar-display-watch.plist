<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>wallpaper-calendar-display-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/xcrun</string>
    <string>swift</string>
    <string>__DIR__/watch-display-changes.swift</string>
    <string>__DIR__/refresh-system-wallpaper.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__DIR__/out/live/display-watch.log</string>
  <key>StandardErrorPath</key>
  <string>__DIR__/out/live/display-watch.log</string>
</dict>
</plist>
