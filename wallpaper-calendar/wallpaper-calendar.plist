<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>wallpaper-calendar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DIR__/refresh-system-wallpaper.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>0</integer>
    <key>Minute</key>
    <integer>4</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__DIR__/out/live/refresh.log</string>
  <key>StandardErrorPath</key>
  <string>__DIR__/out/live/refresh.log</string>
</dict>
</plist>
