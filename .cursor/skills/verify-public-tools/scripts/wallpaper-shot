#!/usr/bin/env bash
# One wallpaper.html CDP/Chrome screenshot (not the full 48-image generate.sh).
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/../../../.." && pwd)
YEAR=${1:-2026}
MONTH=${2:-1}
STYLE=${3:-gradient}
W=${4:-1280}
H=${5:-720}
RUN_ID=${RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}
OUT=${SHOT_OUT:-$ROOT/scratchpad/verify-public-tools/$RUN_ID}
mkdir -p "$OUT"
CHROME="${CHROME:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
HTML="$ROOT/wallpaper-calendar/wallpaper.html"
FILE="$OUT/wallpaper-${YEAR}-$(printf '%02d' "$MONTH")-${STYLE}-${W}x${H}.png"
PROFILE=$(mktemp -d)

# The 25s alarm kills Chrome after the PNG is written. Children can recreate
# profile files during rm, so cleanup retries and must not change the shot's exit status.
stop_profile_chrome() {
  local pid args
  [[ -n "${PROFILE:-}" ]] || return 0
  if [[ -d /proc ]]; then
    for pid in /proc/[0-9]*; do
      pid="${pid#/proc/}"
      [[ "$pid" == "$$" ]] && continue
      # cat, not a shell redirect: the pid can vanish between glob and read.
      args=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
      if [[ "$args" == *"--user-data-dir=${PROFILE}"* ]]; then
        kill "$pid" 2>/dev/null || true
      fi
    done
  elif command -v pgrep >/dev/null 2>&1; then
    local pids
    pids=$(pgrep -f -- "--user-data-dir=${PROFILE}" || true)
    for pid in $pids; do
      [[ "$pid" == "$$" ]] && continue
      kill "$pid" 2>/dev/null || true
    done
  fi
}

cleanup() {
  local status=$?
  local _
  if [[ -n "${PROFILE:-}" && -d "$PROFILE" ]]; then
    for _ in 1 2 3 4 5; do
      stop_profile_chrome
      rm -rf "$PROFILE" 2>/dev/null && break
      sleep 0.3
    done
    rm -rf "$PROFILE" 2>/dev/null || true
  fi
  exit "$status"
}
trap cleanup EXIT

URL="file://${HTML}?year=${YEAR}&month=${MONTH}&style=${STYLE}"
echo "OUT=$OUT"
echo "FILE=$FILE"
perl -e 'alarm shift; exec @ARGV' 25 \
  "$CHROME" --headless --disable-gpu --hide-scrollbars \
  --no-first-run --disable-component-update --disable-background-networking \
  --user-data-dir="$PROFILE" \
  --force-device-scale-factor=1 --window-size="$W,$H" \
  --virtual-time-budget=1500 \
  --screenshot="$FILE" "$URL" >/dev/null 2>&1 || true
[[ -s "$FILE" ]] || { echo "FAILED: empty screenshot" >&2; exit 1; }
ls -la "$FILE"
